///|
test "httpwg: large-generated - large token" {
  let expected : Item = {
    value: SfToken(
      "",
    ),
    parameters: [],
  }
  match
    parse_item(
      "",
    ) {
    Ok(parsed) => {
      assert_eq(parsed, expected)
      match serialize_item(parsed) {
        Ok(s) =>
          assert_eq(
            s, "",
          )
        Err(_) => fail("expected canonical serialization")
      }
    }
    Err(_) => fail("expected item to parse")
  }
}

///|
test "httpwg: large-generated - large byte sequence" {
  let expected : Item = {
    value: SfByteSequence(
      base64_decode(
        "",
      ).unwrap(),
    ),
    parameters: [],
  }
  match
    parse_item(
      "::",
    ) {
    Ok(parsed) => {
      assert_eq(parsed, expected)
      match serialize_item(parsed) {
        Ok(s) =>
          assert_eq(
            s, "::",
          )
        Err(_) => fail("expected canonical serialization")
      }
    }
    Err(_) => fail("expected item to parse")
  }
}

